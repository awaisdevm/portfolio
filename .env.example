# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# API Security
MOBILE_API_KEY=your_mobile_api_key_for_app_access
ADMIN_EMAIL=your_admin_email_for_upload_restriction

# --- Advanced Security (Play Integrity & Rate Limiting) ---
# Google Play Integrity Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_PLAY_PACKAGE_NAME=com.your.app.package

# Integrity bypass for development (set to false in production)
INTEGRITY_BYPASS=true

# Rate Limiting (Requests per Window)
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW_MS=3600000 
